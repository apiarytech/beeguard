        {"tag": "Guard1.Weight", "address": "holding-register:3:REAL"},
        {"tag": "Guard1.Humidity", "address": "holding-register:5:REAL"},
        {"tag": "Guard1.Lid", "address": "coil:1:BOOL"}
      ]
    }
  ]
}
