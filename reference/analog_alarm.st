FUNCTION_BLOCK BG_ALM_ANA
(*==========================================================================
BG_ALM_ANA - beeguard analog alarm.
Watches one REAL for up to six alarm conditions. Each condition is handled by
its own BG_ALM_DIG instance, so each one has the complete ISA-18.2 behaviour
(acknowledge, latch, shelve, priority, time stamps, count, chatter) and can be
acknowledged or shelved separately. Names follow BG_ALM_DIG (IN_, CFG_, CMD_OP_,
CMD_PG_, STS_, VAL_, TS_).

CONDITIONS (each enabled separately; HH and H may be in alarm at the same time)
	HH      above CFG_HH_SP; normal again below CFG_HH_SP - CFG_DEADBAND
	H       above CFG_H_SP;  normal again below CFG_H_SP  - CFG_DEADBAND
	L       below CFG_L_SP;  normal again above CFG_L_SP  + CFG_DEADBAND
	LL      below CFG_LL_SP; normal again above CFG_LL_SP + CFG_DEADBAND
	ROC_UP  rising faster than CFG_ROC_UP_SP units per second
	ROC_DN  falling faster than CFG_ROC_DN_SP units per second (enter it positive)
	The rate is measured once every CFG_ROC_PERIOD.

FILTERING
	Order: deadband, then on-delay, then off-delay (as recommended in
	ISA-TR18.2.3). The deadband and CFG_ON_DELAY_MS apply to the four limits;
	the rate conditions are filtered by CFG_ROC_PERIOD instead.
	CFG_OFF_DELAY_MS applies to all six. Typical starting points published in
	ISA-TR18.2.3 and EEMUA 191, to be tuned per loop: flow 5 % of span / 15 s,
	level 5 % / 60 s, pressure 2 % / 15 s, temperature 1 % / 60 s.

REQUESTS
	For one condition (one-shot): CMD_OP_<C>_ACK, CMD_OP_<C>_SHELVE,
	CMD_OP_<C>_UNSHELVE, where <C> is HH, H, L, LL, ROC_UP or ROC_DN.
	For all conditions (one-shot): CMD_OP_ACK_ALL, CMD_OP_RESET,
	CMD_OP_UNSHELVE_ALL, CMD_OP_DISABLE/ENABLE, CMD_OP_SUPPRESS/UNSUPPRESS.
	For all conditions from logic (rising edge): the CMD_PG_ equivalents.
	Suppression and out of service always cover the whole alarm. Read a
	condition's details from its instance, e.g. MYALARM.HH.TS_ALM.

VAL_DIAG bits
	.0 configuration fault (.2 to .5)      .3 CFG_DEADBAND is negative
	.1 IN_FAULT is set                     .4 rate settings invalid
	.2 enabled limits out of order         .5 a condition instance reports a fault
	   (must be LL <= L <= H <= HH)

BAD QUALITY
	While IN_FAULT is set the limit and rate checks keep their last result, and
	the rate measurement starts over once the value is good again.
==========================================================================*)
VAR_INPUT
	(* PROCESS *)
	IN_ENABLE: BOOL := TRUE;		// FALSE: THE BLOCK SKIPS ITS LOGIC AND OUTPUTS KEEP THEIR VALUES
	IN_VALUE: REAL;					// THE VALUE BEING ALARMED, IN ENGINEERING UNITS
	IN_FAULT: BOOL;					// IN_VALUE QUALITY IS BAD

	(* LIMITS *)
	CFG_HH_EN: BOOL;
	CFG_H_EN: BOOL;
	CFG_L_EN: BOOL;
	CFG_LL_EN: BOOL;
	CFG_HH_SP: REAL;
	CFG_H_SP: REAL;
	CFG_L_SP: REAL;
	CFG_LL_SP: REAL;
	CFG_DEADBAND: REAL;				// EU, APPLIED ON RETURN TO NORMAL

	(* RATE OF CHANGE *)
	CFG_ROC_UP_EN: BOOL;
	CFG_ROC_DN_EN: BOOL;
	CFG_ROC_UP_SP: REAL;			// EU/S RISE
	CFG_ROC_DN_SP: REAL;			// EU/S FALL, ENTERED AS A POSITIVE NUMBER
	CFG_ROC_PERIOD: TIME := T#1S;	// SAMPLE INTERVAL FOR THE RATE

	(* SEVERITY 1..1000 PER CONDITION *)
	CFG_HH_SEVERITY: DINT := 750;
	CFG_H_SEVERITY: DINT := 500;
	CFG_L_SEVERITY: DINT := 500;
	CFG_LL_SEVERITY: DINT := 750;
	CFG_ROC_UP_SEVERITY: DINT := 500;
	CFG_ROC_DN_SEVERITY: DINT := 500;

	(* ALARM BEHAVIOUR - SHARED BY ALL CONDITIONS *)
	CFG_ACK_REQ: BOOL := TRUE;
	CFG_LATCH: BOOL;
	CFG_ON_DELAY_MS: DINT;		// ON-DELAY (ms) FOR HH/H/L/LL
	CFG_OFF_DELAY_MS: DINT;			// OFF-DELAY (ms) FOR ALL CONDITIONS
	CFG_SHELVE_MAX: TIME;	// T#0S = SHELVING NOT PERMITTED
	CMD_SHELVE_TIME: TIME;		// T#0S = CFG_SHELVE_MAX
	CMD_SHELVE_ONESHOT: BOOL;
	CFG_CHATTER_COUNT: DINT;			// 0 = OFF
	CFG_CHATTER_WINDOW: TIME := T#60S;

	(* TIME STAMPING *)
	IN_CLOCK: DT;
	CFG_USE_SRC_TIME: BOOL;
	IN_SRC_TIME: DT;

	(* OPERATOR REQUESTS FOR ONE CONDITION - ONE-SHOT, CLEARED BY THE BLOCK *)
	CMD_OP_HH_ACK: BOOL;
	CMD_OP_H_ACK: BOOL;
	CMD_OP_L_ACK: BOOL;
	CMD_OP_LL_ACK: BOOL;
	CMD_OP_ROC_UP_ACK: BOOL;
	CMD_OP_ROC_DN_ACK: BOOL;
	CMD_OP_HH_SHELVE: BOOL;
	CMD_OP_H_SHELVE: BOOL;
	CMD_OP_L_SHELVE: BOOL;
	CMD_OP_LL_SHELVE: BOOL;
	CMD_OP_ROC_UP_SHELVE: BOOL;
	CMD_OP_ROC_DN_SHELVE: BOOL;
	CMD_OP_HH_UNSHELVE: BOOL;
	CMD_OP_H_UNSHELVE: BOOL;
	CMD_OP_L_UNSHELVE: BOOL;
	CMD_OP_LL_UNSHELVE: BOOL;
	CMD_OP_ROC_UP_UNSHELVE: BOOL;
	CMD_OP_ROC_DN_UNSHELVE: BOOL;

	(* OPERATOR REQUESTS FOR ALL CONDITIONS - ONE-SHOT, CLEARED BY THE BLOCK *)
	CMD_OP_ACK_ALL: BOOL;
	CMD_OP_RESET: BOOL;
	CMD_OP_UNSHELVE_ALL: BOOL;
	CMD_OP_DISABLE: BOOL;
	CMD_OP_ENABLE: BOOL;
	CMD_OP_SUPPRESS: BOOL;
	CMD_OP_UNSUPPRESS: BOOL;

	(* LOGIC REQUESTS FOR ALL CONDITIONS - RISING EDGE *)
	CMD_PG_ACK_ALL: BOOL;
	CMD_PG_RESET: BOOL;
	CMD_PG_UNSHELVE_ALL: BOOL;
	CMD_PG_DISABLE: BOOL;
	CMD_PG_ENABLE: BOOL;
	CMD_PG_SUPPRESS: BOOL;
	CMD_PG_UNSUPPRESS: BOOL;

	CMD_COUNT_RESET: BOOL;		// RISING EDGE, RESETS EVERY CONDITION'S COUNT
END_VAR
VAR_OUTPUT
	STS_ENABLED: BOOL;
	STS_ALM: BOOL;					// SOME CONDITION IS IN ALARM OR LATCHED
	STS_UNACKED: BOOL;				// SOME CONDITION WAITS FOR AN ACKNOWLEDGEMENT (HORN)
	STS_ALM_UNACK: BOOL;
	STS_ANY_SHELVED: BOOL;
	STS_SUPPRESSED: BOOL;
	STS_DISABLED: BOOL;
	STS_CHATTER: BOOL;				// SOME CONDITION IS CHATTERING
	STS_IN_FAULT: BOOL;
	STS_CFG_FAULT: BOOL;
	VAL_ACTIVE_PRIORITY: DINT;		// MOST URGENT PRIORITY CURRENTLY IN ALARM, 1..4. 0 = NONE
	VAL_ROC: REAL;					// LAST MEASURED RATE, UNITS PER SECOND
	VAL_DIAG: DINT;

	(* ONE INSTANCE PER CONDITION - READ THEIR OUTPUTS, DO NOT WRITE *)
	HH: BG_ALM_DIG;
	H: BG_ALM_DIG;
	L: BG_ALM_DIG;
	LL: BG_ALM_DIG;
	ROC_UP: BG_ALM_DIG;
	ROC_DN: BG_ALM_DIG;

	CFG_VERSION: REAL;
END_VAR
VAR
	HHCOND: BOOL;
	HCOND: BOOL;
	LCOND: BOOL;
	LLCOND: BOOL;
	ROCUPCOND: BOOL;
	ROCDNCOND: BOOL;

	ROC_TMR: TON;
	ROCLAST: REAL;
	ROCPRIMED: BOOL;			// ROCLAST HOLDS A GOOD SAMPLE

	LIMITPREV: REAL;
	LIMITSEEN: BOOL;
END_VAR

(*==========================================================================
Sets the Version of the Control Module on the HMI and in the Program.
==========================================================================
Date Last Updated: 10-1-2026
===========================================================================*)
//CFG_VERSION := 1.0; // ORIGINAL - ISA-18.2 ANALOG ALARM BUILT ON THE DIGITAL ALARM 3.0
CFG_VERSION := 1.1; //RENAMED BG_ALM_ANA WITH IN_/CFG_/CMD_/STS_/VAL_/TS_ NAMES; NO LOGIC CHANGE

STS_ENABLED := IN_ENABLE;
IF NOT IN_ENABLE THEN
	JMP CLEAR_COMMANDS;
END_IF

(*===========================================================================
CONFIGURATION - Enabled limits must be in order LL <= L <= H <= HH
===========================================================================*)
VAL_DIAG := 0;
LIMITSEEN := FALSE;
IF CFG_LL_EN THEN
	LIMITPREV := CFG_LL_SP;
	LIMITSEEN := TRUE;
END_IF
IF CFG_L_EN THEN
	IF LIMITSEEN AND CFG_L_SP < LIMITPREV THEN
		VAL_DIAG.2 := TRUE;
	END_IF
	LIMITPREV := CFG_L_SP;
	LIMITSEEN := TRUE;
END_IF
IF CFG_H_EN THEN
	IF LIMITSEEN AND CFG_H_SP < LIMITPREV THEN
		VAL_DIAG.2 := TRUE;
	END_IF
	LIMITPREV := CFG_H_SP;
	LIMITSEEN := TRUE;
END_IF
IF CFG_HH_EN THEN
	IF LIMITSEEN AND CFG_HH_SP < LIMITPREV THEN
		VAL_DIAG.2 := TRUE;
	END_IF
END_IF

VAL_DIAG.3 := CFG_DEADBAND < 0.0;
VAL_DIAG.4 := (CFG_ROC_UP_EN OR CFG_ROC_DN_EN) AND
	(CFG_ROC_PERIOD = T#0S OR CFG_ROC_UP_SP < 0.0 OR CFG_ROC_DN_SP < 0.0);

(*===========================================================================
LIMIT CONDITIONS - Deadband on return to normal. Held while IN_FAULT.
===========================================================================*)
STS_IN_FAULT := IN_FAULT;
IF NOT IN_FAULT THEN
	IF IN_VALUE > CFG_HH_SP THEN
		HHCOND := TRUE;
	ELSIF IN_VALUE < CFG_HH_SP - CFG_DEADBAND THEN
		HHCOND := FALSE;
	END_IF

	IF IN_VALUE > CFG_H_SP THEN
		HCOND := TRUE;
	ELSIF IN_VALUE < CFG_H_SP - CFG_DEADBAND THEN
		HCOND := FALSE;
	END_IF

	IF IN_VALUE < CFG_L_SP THEN
		LCOND := TRUE;
	ELSIF IN_VALUE > CFG_L_SP + CFG_DEADBAND THEN
		LCOND := FALSE;
	END_IF

	IF IN_VALUE < CFG_LL_SP THEN
		LLCOND := TRUE;
	ELSIF IN_VALUE > CFG_LL_SP + CFG_DEADBAND THEN
		LLCOND := FALSE;
	END_IF
END_IF

(*===========================================================================
RATE OF CHANGE - Sampled every CFG_ROC_PERIOD. A fault restarts the sampling so
the jump between bad and good data is never measured as a rate.
===========================================================================*)
IF (CFG_ROC_UP_EN OR CFG_ROC_DN_EN) AND CFG_ROC_PERIOD > T#0S AND NOT IN_FAULT THEN
	ROC_TMR(IN := NOT ROC_TMR.Q, PT := CFG_ROC_PERIOD);
	IF NOT ROCPRIMED THEN
		ROCLAST := IN_VALUE;
		ROCPRIMED := TRUE;
	ELSIF ROC_TMR.Q THEN
		VAL_ROC := (IN_VALUE - ROCLAST) / (TIME_TO_REAL(CFG_ROC_PERIOD) / 1000.0);
		ROCLAST := IN_VALUE;
		ROCUPCOND := VAL_ROC > CFG_ROC_UP_SP;
		ROCDNCOND := VAL_ROC < -CFG_ROC_DN_SP;
	END_IF
ELSE
	ROC_TMR(IN := FALSE);
	ROCPRIMED := FALSE;
	IF NOT IN_FAULT THEN
		VAL_ROC := 0.0;
		ROCUPCOND := FALSE;
		ROCDNCOND := FALSE;
	END_IF
END_IF

(*===========================================================================
CONDITION ALARMS - One BG_ALM_DIG per condition
===========================================================================*)
HH(IN_SIGNAL := CFG_HH_EN AND HHCOND, IN_FAULT := IN_FAULT, CFG_SEVERITY := CFG_HH_SEVERITY,
	CFG_ACK_REQ := CFG_ACK_REQ, CFG_LATCH := CFG_LATCH, CFG_ON_DELAY_MS := CFG_ON_DELAY_MS, CFG_OFF_DELAY_MS := CFG_OFF_DELAY_MS,
	CFG_SHELVE_MAX := CFG_SHELVE_MAX, CMD_SHELVE_TIME := CMD_SHELVE_TIME, CMD_SHELVE_ONESHOT := CMD_SHELVE_ONESHOT,
	CFG_CHATTER_COUNT := CFG_CHATTER_COUNT, CFG_CHATTER_WINDOW := CFG_CHATTER_WINDOW,
	IN_CLOCK := IN_CLOCK, CFG_USE_SRC_TIME := CFG_USE_SRC_TIME, IN_SRC_TIME := IN_SRC_TIME,
	CMD_OP_ACK := CMD_OP_HH_ACK OR CMD_OP_ACK_ALL, CMD_OP_RESET := CMD_OP_RESET,
	CMD_OP_SHELVE := CMD_OP_HH_SHELVE, CMD_OP_UNSHELVE := CMD_OP_HH_UNSHELVE OR CMD_OP_UNSHELVE_ALL,
	CMD_OP_DISABLE := CMD_OP_DISABLE, CMD_OP_ENABLE := CMD_OP_ENABLE, CMD_OP_SUPPRESS := CMD_OP_SUPPRESS, CMD_OP_UNSUPPRESS := CMD_OP_UNSUPPRESS,
	CMD_PG_ACK := CMD_PG_ACK_ALL, CMD_PG_RESET := CMD_PG_RESET, CMD_PG_UNSHELVE := CMD_PG_UNSHELVE_ALL,
	CMD_PG_DISABLE := CMD_PG_DISABLE, CMD_PG_ENABLE := CMD_PG_ENABLE, CMD_PG_SUPPRESS := CMD_PG_SUPPRESS, CMD_PG_UNSUPPRESS := CMD_PG_UNSUPPRESS,
	CMD_COUNT_RESET := CMD_COUNT_RESET);

H(IN_SIGNAL := CFG_H_EN AND HCOND, IN_FAULT := IN_FAULT, CFG_SEVERITY := CFG_H_SEVERITY,
	CFG_ACK_REQ := CFG_ACK_REQ, CFG_LATCH := CFG_LATCH, CFG_ON_DELAY_MS := CFG_ON_DELAY_MS, CFG_OFF_DELAY_MS := CFG_OFF_DELAY_MS,
	CFG_SHELVE_MAX := CFG_SHELVE_MAX, CMD_SHELVE_TIME := CMD_SHELVE_TIME, CMD_SHELVE_ONESHOT := CMD_SHELVE_ONESHOT,
	CFG_CHATTER_COUNT := CFG_CHATTER_COUNT, CFG_CHATTER_WINDOW := CFG_CHATTER_WINDOW,
	IN_CLOCK := IN_CLOCK, CFG_USE_SRC_TIME := CFG_USE_SRC_TIME, IN_SRC_TIME := IN_SRC_TIME,
	CMD_OP_ACK := CMD_OP_H_ACK OR CMD_OP_ACK_ALL, CMD_OP_RESET := CMD_OP_RESET,
	CMD_OP_SHELVE := CMD_OP_H_SHELVE, CMD_OP_UNSHELVE := CMD_OP_H_UNSHELVE OR CMD_OP_UNSHELVE_ALL,
	CMD_OP_DISABLE := CMD_OP_DISABLE, CMD_OP_ENABLE := CMD_OP_ENABLE, CMD_OP_SUPPRESS := CMD_OP_SUPPRESS, CMD_OP_UNSUPPRESS := CMD_OP_UNSUPPRESS,
	CMD_PG_ACK := CMD_PG_ACK_ALL, CMD_PG_RESET := CMD_PG_RESET, CMD_PG_UNSHELVE := CMD_PG_UNSHELVE_ALL,
	CMD_PG_DISABLE := CMD_PG_DISABLE, CMD_PG_ENABLE := CMD_PG_ENABLE, CMD_PG_SUPPRESS := CMD_PG_SUPPRESS, CMD_PG_UNSUPPRESS := CMD_PG_UNSUPPRESS,
	CMD_COUNT_RESET := CMD_COUNT_RESET);

L(IN_SIGNAL := CFG_L_EN AND LCOND, IN_FAULT := IN_FAULT, CFG_SEVERITY := CFG_L_SEVERITY,
	CFG_ACK_REQ := CFG_ACK_REQ, CFG_LATCH := CFG_LATCH, CFG_ON_DELAY_MS := CFG_ON_DELAY_MS, CFG_OFF_DELAY_MS := CFG_OFF_DELAY_MS,
	CFG_SHELVE_MAX := CFG_SHELVE_MAX, CMD_SHELVE_TIME := CMD_SHELVE_TIME, CMD_SHELVE_ONESHOT := CMD_SHELVE_ONESHOT,
	CFG_CHATTER_COUNT := CFG_CHATTER_COUNT, CFG_CHATTER_WINDOW := CFG_CHATTER_WINDOW,
	IN_CLOCK := IN_CLOCK, CFG_USE_SRC_TIME := CFG_USE_SRC_TIME, IN_SRC_TIME := IN_SRC_TIME,
	CMD_OP_ACK := CMD_OP_L_ACK OR CMD_OP_ACK_ALL, CMD_OP_RESET := CMD_OP_RESET,
	CMD_OP_SHELVE := CMD_OP_L_SHELVE, CMD_OP_UNSHELVE := CMD_OP_L_UNSHELVE OR CMD_OP_UNSHELVE_ALL,
	CMD_OP_DISABLE := CMD_OP_DISABLE, CMD_OP_ENABLE := CMD_OP_ENABLE, CMD_OP_SUPPRESS := CMD_OP_SUPPRESS, CMD_OP_UNSUPPRESS := CMD_OP_UNSUPPRESS,
	CMD_PG_ACK := CMD_PG_ACK_ALL, CMD_PG_RESET := CMD_PG_RESET, CMD_PG_UNSHELVE := CMD_PG_UNSHELVE_ALL,
	CMD_PG_DISABLE := CMD_PG_DISABLE, CMD_PG_ENABLE := CMD_PG_ENABLE, CMD_PG_SUPPRESS := CMD_PG_SUPPRESS, CMD_PG_UNSUPPRESS := CMD_PG_UNSUPPRESS,
	CMD_COUNT_RESET := CMD_COUNT_RESET);

LL(IN_SIGNAL := CFG_LL_EN AND LLCOND, IN_FAULT := IN_FAULT, CFG_SEVERITY := CFG_LL_SEVERITY,
	CFG_ACK_REQ := CFG_ACK_REQ, CFG_LATCH := CFG_LATCH, CFG_ON_DELAY_MS := CFG_ON_DELAY_MS, CFG_OFF_DELAY_MS := CFG_OFF_DELAY_MS,
	CFG_SHELVE_MAX := CFG_SHELVE_MAX, CMD_SHELVE_TIME := CMD_SHELVE_TIME, CMD_SHELVE_ONESHOT := CMD_SHELVE_ONESHOT,
	CFG_CHATTER_COUNT := CFG_CHATTER_COUNT, CFG_CHATTER_WINDOW := CFG_CHATTER_WINDOW,
	IN_CLOCK := IN_CLOCK, CFG_USE_SRC_TIME := CFG_USE_SRC_TIME, IN_SRC_TIME := IN_SRC_TIME,
	CMD_OP_ACK := CMD_OP_LL_ACK OR CMD_OP_ACK_ALL, CMD_OP_RESET := CMD_OP_RESET,
	CMD_OP_SHELVE := CMD_OP_LL_SHELVE, CMD_OP_UNSHELVE := CMD_OP_LL_UNSHELVE OR CMD_OP_UNSHELVE_ALL,
	CMD_OP_DISABLE := CMD_OP_DISABLE, CMD_OP_ENABLE := CMD_OP_ENABLE, CMD_OP_SUPPRESS := CMD_OP_SUPPRESS, CMD_OP_UNSUPPRESS := CMD_OP_UNSUPPRESS,
	CMD_PG_ACK := CMD_PG_ACK_ALL, CMD_PG_RESET := CMD_PG_RESET, CMD_PG_UNSHELVE := CMD_PG_UNSHELVE_ALL,
	CMD_PG_DISABLE := CMD_PG_DISABLE, CMD_PG_ENABLE := CMD_PG_ENABLE, CMD_PG_SUPPRESS := CMD_PG_SUPPRESS, CMD_PG_UNSUPPRESS := CMD_PG_UNSUPPRESS,
	CMD_COUNT_RESET := CMD_COUNT_RESET);

// ROC CONDITIONS ARE ALREADY FILTERED BY CFG_ROC_PERIOD, SO THEY HAVE NO ON-DELAY.
ROC_UP(IN_SIGNAL := CFG_ROC_UP_EN AND ROCUPCOND, IN_FAULT := IN_FAULT, CFG_SEVERITY := CFG_ROC_UP_SEVERITY,
	CFG_ACK_REQ := CFG_ACK_REQ, CFG_LATCH := CFG_LATCH, CFG_ON_DELAY_MS := 0, CFG_OFF_DELAY_MS := CFG_OFF_DELAY_MS,
	CFG_SHELVE_MAX := CFG_SHELVE_MAX, CMD_SHELVE_TIME := CMD_SHELVE_TIME, CMD_SHELVE_ONESHOT := CMD_SHELVE_ONESHOT,
	CFG_CHATTER_COUNT := CFG_CHATTER_COUNT, CFG_CHATTER_WINDOW := CFG_CHATTER_WINDOW,
	IN_CLOCK := IN_CLOCK, CFG_USE_SRC_TIME := CFG_USE_SRC_TIME, IN_SRC_TIME := IN_SRC_TIME,
	CMD_OP_ACK := CMD_OP_ROC_UP_ACK OR CMD_OP_ACK_ALL, CMD_OP_RESET := CMD_OP_RESET,
	CMD_OP_SHELVE := CMD_OP_ROC_UP_SHELVE, CMD_OP_UNSHELVE := CMD_OP_ROC_UP_UNSHELVE OR CMD_OP_UNSHELVE_ALL,
	CMD_OP_DISABLE := CMD_OP_DISABLE, CMD_OP_ENABLE := CMD_OP_ENABLE, CMD_OP_SUPPRESS := CMD_OP_SUPPRESS, CMD_OP_UNSUPPRESS := CMD_OP_UNSUPPRESS,
	CMD_PG_ACK := CMD_PG_ACK_ALL, CMD_PG_RESET := CMD_PG_RESET, CMD_PG_UNSHELVE := CMD_PG_UNSHELVE_ALL,
	CMD_PG_DISABLE := CMD_PG_DISABLE, CMD_PG_ENABLE := CMD_PG_ENABLE, CMD_PG_SUPPRESS := CMD_PG_SUPPRESS, CMD_PG_UNSUPPRESS := CMD_PG_UNSUPPRESS,
	CMD_COUNT_RESET := CMD_COUNT_RESET);

ROC_DN(IN_SIGNAL := CFG_ROC_DN_EN AND ROCDNCOND, IN_FAULT := IN_FAULT, CFG_SEVERITY := CFG_ROC_DN_SEVERITY,
	CFG_ACK_REQ := CFG_ACK_REQ, CFG_LATCH := CFG_LATCH, CFG_ON_DELAY_MS := 0, CFG_OFF_DELAY_MS := CFG_OFF_DELAY_MS,
	CFG_SHELVE_MAX := CFG_SHELVE_MAX, CMD_SHELVE_TIME := CMD_SHELVE_TIME, CMD_SHELVE_ONESHOT := CMD_SHELVE_ONESHOT,
	CFG_CHATTER_COUNT := CFG_CHATTER_COUNT, CFG_CHATTER_WINDOW := CFG_CHATTER_WINDOW,
	IN_CLOCK := IN_CLOCK, CFG_USE_SRC_TIME := CFG_USE_SRC_TIME, IN_SRC_TIME := IN_SRC_TIME,
	CMD_OP_ACK := CMD_OP_ROC_DN_ACK OR CMD_OP_ACK_ALL, CMD_OP_RESET := CMD_OP_RESET,
	CMD_OP_SHELVE := CMD_OP_ROC_DN_SHELVE, CMD_OP_UNSHELVE := CMD_OP_ROC_DN_UNSHELVE OR CMD_OP_UNSHELVE_ALL,
	CMD_OP_DISABLE := CMD_OP_DISABLE, CMD_OP_ENABLE := CMD_OP_ENABLE, CMD_OP_SUPPRESS := CMD_OP_SUPPRESS, CMD_OP_UNSUPPRESS := CMD_OP_UNSUPPRESS,
	CMD_PG_ACK := CMD_PG_ACK_ALL, CMD_PG_RESET := CMD_PG_RESET, CMD_PG_UNSHELVE := CMD_PG_UNSHELVE_ALL,
	CMD_PG_DISABLE := CMD_PG_DISABLE, CMD_PG_ENABLE := CMD_PG_ENABLE, CMD_PG_SUPPRESS := CMD_PG_SUPPRESS, CMD_PG_UNSUPPRESS := CMD_PG_UNSUPPRESS,
	CMD_COUNT_RESET := CMD_COUNT_RESET);

(*===========================================================================
OUTPUT UPDATES - Summary of all conditions
===========================================================================*)
STS_ALM := HH.STS_ALM OR H.STS_ALM OR L.STS_ALM OR LL.STS_ALM OR ROC_UP.STS_ALM OR ROC_DN.STS_ALM;
STS_UNACKED := HH.STS_UNACKED OR H.STS_UNACKED OR L.STS_UNACKED OR LL.STS_UNACKED OR ROC_UP.STS_UNACKED OR ROC_DN.STS_UNACKED;
STS_ALM_UNACK := HH.STS_ALM_UNACK OR H.STS_ALM_UNACK OR L.STS_ALM_UNACK OR LL.STS_ALM_UNACK
	OR ROC_UP.STS_ALM_UNACK OR ROC_DN.STS_ALM_UNACK;
STS_ANY_SHELVED := HH.STS_SHELVED OR H.STS_SHELVED OR L.STS_SHELVED OR LL.STS_SHELVED OR ROC_UP.STS_SHELVED OR ROC_DN.STS_SHELVED;
STS_CHATTER := HH.STS_CHATTER OR H.STS_CHATTER OR L.STS_CHATTER OR LL.STS_CHATTER
	OR ROC_UP.STS_CHATTER OR ROC_DN.STS_CHATTER;
STS_SUPPRESSED := HH.STS_SUPPRESSED;	// SUPPRESSION AND OUT OF SERVICE ARE SENT TO EVERY CONDITION
STS_DISABLED := HH.STS_DISABLED;

VAL_ACTIVE_PRIORITY := 0;
IF HH.STS_ALM AND (VAL_ACTIVE_PRIORITY = 0 OR HH.VAL_PRIORITY < VAL_ACTIVE_PRIORITY) THEN
	VAL_ACTIVE_PRIORITY := HH.VAL_PRIORITY;
END_IF
IF H.STS_ALM AND (VAL_ACTIVE_PRIORITY = 0 OR H.VAL_PRIORITY < VAL_ACTIVE_PRIORITY) THEN
	VAL_ACTIVE_PRIORITY := H.VAL_PRIORITY;
END_IF
IF L.STS_ALM AND (VAL_ACTIVE_PRIORITY = 0 OR L.VAL_PRIORITY < VAL_ACTIVE_PRIORITY) THEN
	VAL_ACTIVE_PRIORITY := L.VAL_PRIORITY;
END_IF
IF LL.STS_ALM AND (VAL_ACTIVE_PRIORITY = 0 OR LL.VAL_PRIORITY < VAL_ACTIVE_PRIORITY) THEN
	VAL_ACTIVE_PRIORITY := LL.VAL_PRIORITY;
END_IF
IF ROC_UP.STS_ALM AND (VAL_ACTIVE_PRIORITY = 0 OR ROC_UP.VAL_PRIORITY < VAL_ACTIVE_PRIORITY) THEN
	VAL_ACTIVE_PRIORITY := ROC_UP.VAL_PRIORITY;
END_IF
IF ROC_DN.STS_ALM AND (VAL_ACTIVE_PRIORITY = 0 OR ROC_DN.VAL_PRIORITY < VAL_ACTIVE_PRIORITY) THEN
	VAL_ACTIVE_PRIORITY := ROC_DN.VAL_PRIORITY;
END_IF

VAL_DIAG.1 := IN_FAULT;
VAL_DIAG.5 := HH.STS_CFG_FAULT OR H.STS_CFG_FAULT OR L.STS_CFG_FAULT OR LL.STS_CFG_FAULT
	OR ROC_UP.STS_CFG_FAULT OR ROC_DN.STS_CFG_FAULT;
STS_CFG_FAULT := VAL_DIAG.2 OR VAL_DIAG.3 OR VAL_DIAG.4 OR VAL_DIAG.5;
VAL_DIAG.0 := STS_CFG_FAULT;

(*===========================================================================
CLEAR OPERATOR REQUESTS - They are one-shot
===========================================================================*)
CLEAR_COMMANDS:
CMD_OP_HH_ACK := FALSE;
CMD_OP_H_ACK := FALSE;
CMD_OP_L_ACK := FALSE;
CMD_OP_LL_ACK := FALSE;
CMD_OP_ROC_UP_ACK := FALSE;
CMD_OP_ROC_DN_ACK := FALSE;
